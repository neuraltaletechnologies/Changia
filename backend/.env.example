# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (or * for development)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Database (MySQL) — change these to match YOUR MySQL setup ───────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=changia
# Managed cloud MySQL (Aiven, TiDB Cloud, Railway, PlanetScale) requires TLS.
# Set DB_SSL=true in that case. DB_SSL_CA is optional: a PEM string or a path to
# the provider's CA bundle for strict cert verification. Leave DB_SSL blank/false
# for a local MySQL / XAMPP.
DB_SSL=false
DB_SSL_CA=

# ─── Cloudflare R2 — durable storage for uploaded photos ─────────────────────
# Set all four when the host has an ephemeral disk (Render free, most PaaS) so
# campaign / payout / completion-report photos survive redeploys. Create an R2
# bucket + an API token (Object Read & Write) in the Cloudflare dashboard.
# Leave blank to keep photos on the local disk (local dev, persistent-disk hosts).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional — defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ─── Platform settings ────────────────────────────────────────────────────────
DEFAULT_SERVICE_FEE_PERCENT=5

# English → Swahili auto-translation for campaign content (name/story/category/
# scope/acceptance). A plain Google Cloud Translation v2 API key. Leave blank to
# disable — the *_sw columns stay empty and public /sw pages fall back to English.
GOOGLE_TRANSLATE_API_KEY=
APP_BASE_URL=http://localhost:3000
# This API's own public origin (used to build absolute /uploads/... URLs for
# completion-report photos). Change in production to the real API domain.
API_PUBLIC_URL=http://localhost:5000

# ─── Messaging providers (SMS / WhatsApp / Email) ─────────────────────────────
# Leave everything below blank to keep MESSAGE_PROVIDER=simulated (default) —
# reminders still work end-to-end, they're just logged instead of delivered.
# Set MESSAGE_PROVIDER=live once you've filled in the credentials for the
# channels you use. Full instructions (where to sign up, which key goes where)
# are in Backend/README.md → "Messaging providers setup".
MESSAGE_PROVIDER=simulated

# Email — SMTP for campaign links to donors, receipts, and password-reset links.
# With no SMTP_HOST/USER/PASSWORD set, emails are logged to the server console.
# Uses port 465 (SSL) by default. Set SMTP_PORT=587 for STARTTLS.
SMTP_HOST=mail.changia.org
SMTP_PORT=465
SMTP_USER=noreply@changia.org.tz
SMTP_PASSWORD=
# Can also use SMTP_PASS instead of SMTP_PASSWORD
# SMTP_PASS=
SMTP_FROM_EMAIL=noreply@changia.org.tz
SMTP_FROM_NAME=Changia

# SMS — Africa's Talking (africastalking.com)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# WhatsApp — Meta WhatsApp Business Cloud API (developers.facebook.com)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# ─── ClickPesa payment gateway ────────────────────────────────────────────────
# Set CLICKPESA_ENABLED=true and fill in credentials from your ClickPesa
# merchant dashboard (Settings → Developers → API application).
# The API key is shown once — store it in a secrets manager for production.
CLICKPESA_ENABLED=false
CLICKPESA_BASE_URL=https://api.clickpesa.com/third-parties
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
# Enable checksum after enabling it in ClickPesa dashboard.
CLICKPESA_USE_CHECKSUM=false
CLICKPESA_CHECKSUM_SECRET=
CLICKPESA_TIMEOUT_MS=15000

# ─── Reminder auto-resend scheduler ────────────────────────────────────────────
# How often (minutes) the background job checks for due reminder schedules.
REMINDER_SCHEDULER_INTERVAL_MINUTES=60
