{
  "name": "changia",
  "version": "1.0.0",
  "private": true,
  "description": "Changia — Digital Fundraising & Mobile Money Contribution Platform",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=changia-api",
    "dev:web": "turbo run dev --filter=changia",
    "preview": "turbo run tunnel dev:preview",
    "start": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "setup:db": "npm --prefix Backend run setup"
  },
  "devDependencies": {
    "turbo": "^2.10.9"
  }
}
