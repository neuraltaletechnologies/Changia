{
  "name": "changia-api",
  "version": "0.1.0",
  "private": true,
  "description": "Changia fundraising platform — secure backend API (Node + Express + MySQL)",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "tunnel": "node ../scripts/tunnel.js --name api --port 5000",
    "dev:preview": "node ../scripts/preview-run.js --target api -- npm run dev",
    "start": "node server.js",
    "setup": "npm install && mysql -u root -p < database.sql"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "africastalking": "^0.7.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "mysql2": "^3.15.3",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "zod": "^4.4.3"
  }
}
