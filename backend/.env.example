# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (or * for development)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Database (MySQL) — change these to match YOUR MySQL setup ───────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=changia

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ─── Platform settings ────────────────────────────────────────────────────────
DEFAULT_SERVICE_FEE_PERCENT=5
APP_BASE_URL=http://localhost:3000
# This API's own public origin (used to build absolute /uploads/... URLs for
# completion-report photos). Change in production to the real API domain.
API_PUBLIC_URL=http://localhost:5000

# ─── Messaging providers (SMS / WhatsApp / Email) ─────────────────────────────
# Leave everything below blank to keep MESSAGE_PROVIDER=simulated (default) —
# reminders still work end-to-end, they're just logged instead of delivered.
# Set MESSAGE_PROVIDER=live once you've filled in the credentials for the
# channels you use. Full instructions (where to sign up, which key goes where)
# are in Backend/README.md → "Messaging providers setup".
MESSAGE_PROVIDER=simulated

# Email — any SMTP account (Gmail app password, SendGrid, Mailgun, Zoho, …)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Changia

# SMS — Africa's Talking (africastalking.com)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# WhatsApp — Meta WhatsApp Business Cloud API (developers.facebook.com)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ─── Reminder auto-resend scheduler ────────────────────────────────────────────
# How often (minutes) the background job checks for due reminder schedules.
REMINDER_SCHEDULER_INTERVAL_MINUTES=60
