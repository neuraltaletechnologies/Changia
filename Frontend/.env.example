# Base URL of the Changia backend API, including the /api/v1 suffix.
# Production example (API on its own subdomain):
#   NEXT_PUBLIC_API_URL=https://api.changia.co.tz/api/v1
# The API's origin is auto-added to the CSP connect-src/img-src (see next.config.mjs).
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
